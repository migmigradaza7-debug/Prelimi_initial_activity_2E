<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5FAFD">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#238FD2">

        <ImageButton
            android:id="@+id/menuButton"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:background="@android:color/transparent"
            android:tint="#FFFFFF"
            android:contentDescription="Open navigation menu"/>

        <ImageView
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:src="@drawable/logo"
            android:scaleType="fitCenter"
            android:contentDescription="SafeSpace Logo"/>

        <ImageButton
            android:id="@+id/notificationButton"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@android:drawable/ic_popup_reminder"
            android:background="@android:color/transparent"
            android:tint="#FFFFFF"
            android:contentDescription="Notifications"/>

    </LinearLayout>


    <ScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hello! 👋"
                android:textSize="27sp"
                android:textStyle="bold"
                android:textColor="#0F3A80"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome to SafeSpace"
                android:textSize="17sp"
                android:textColor="#5F7185"
                android:layout_marginTop="4dp"/>



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/main_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡️  Your Safe Space"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Find a safe and comfortable place within your school."
                    android:textSize="15sp"
                    android:textColor="#E8F9FF"
                    android:layout_marginTop="12dp"/>

                <Button
                    android:id="@+id/superButton"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:text="Explore"
                    android:textColor="#0F3A80"
                    android:textStyle="bold"
                    android:backgroundTint="#FDCF22"
                    android:layout_marginTop="20dp"/>

            </LinearLayout>



            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Access"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#0F3A80"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="12dp"/>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">


                <LinearLayout
                    android:id="@+id/cardSafePlaces"
                    android:layout_width="0dp"
                    android:layout_height="135dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/quick_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Find safe places">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏫"
                        android:textSize="32sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Safe Places"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#0F3A80"
                        android:layout_marginTop="8dp"/>

                </LinearLayout>


                <LinearLayout
                    android:id="@+id/cardTalk"
                    android:layout_width="0dp"
                    android:layout_height="135dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/quick_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Talk to someone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💬"
                        android:textSize="32sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Talk to Someone"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#0F3A80"
                        android:gravity="center"
                        android:layout_marginTop="8dp"/>

                </LinearLayout>

            </LinearLayout>



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:id="@+id/cardResources"
                    android:layout_width="0dp"
                    android:layout_height="135dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/quick_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Open resources">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📚"
                        android:textSize="32sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resources"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#0F3A80"
                        android:layout_marginTop="8dp"/>

                </LinearLayout>


                <LinearLayout
                    android:id="@+id/cardReport"
                    android:layout_width="0dp"
                    android:layout_height="135dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/report_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Report an issue">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚨"
                        android:textSize="32sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Report an Issue"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#A52D27"
                        android:gravity="center"
                        android:layout_marginTop="8dp"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="10dp">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🏠\nHome"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#238FD2"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Home"/>

        <TextView
            android:id="@+id/navPlaces"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="📍\nPlaces"
            android:textSize="12sp"
            android:textColor="#6B7C8F"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Places"/>

        <TextView
            android:id="@+id/navChat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="💬\nChat"
            android:textSize="12sp"
            android:textColor="#6B7C8F"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Chat"/>

        <TextView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="👤\nProfile"
            android:textSize="12sp"
            android:textColor="#6B7C8F"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Profile"/>

    </LinearLayout>

</LinearLayout>
